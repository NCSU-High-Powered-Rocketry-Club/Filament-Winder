{
  "id": "grbl-2axis-v1",
  "name": "GRBL / FluidNC 2-Axis CNC",
  "description": "2-axis filament winder running on GRBL, GRBL-ESP32, or FluidNC CNC controller",
  "controller": {
    "type": "grbl",
    "version": "1.1f+",
    "connection": { "interface": "usb-serial", "baudRate": 115200 }
  },
  "axes": [
    {
      "id": "X", "function": "carriage", "type": "linear", "unit": "mm",
      "range": { "min": 0, "max": 400 },
      "maxSpeed": 6000, "maxAccel": 2000, "homePosition": 0
    },
    {
      "id": "Y", "function": "mandrel_rotation", "type": "rotary", "unit": "degrees",
      "range": { "min": null, "max": null },
      "maxSpeed": 25000, "maxAccel": 5000, "homePosition": 0
    }
  ],
  "gcode": {
    "header": [
      "; Generated by WindStack for GRBL / FluidNC",
      "G21 ; Metric units",
      "G90 ; Absolute coordinates",
      "G94 ; Units per minute feed mode",
      "G92 X0 Y0 ; Set current position as origin"
    ],
    "footer": [
      "G1 X0 F2000 ; Return carriage to start",
      "M2 ; Program end"
    ],
    "coordinateMode": "absolute",
    "lineNumbers": false,
    "checksums": false,
    "decimalPlaces": 3,
    "macros": {},
    "speedControl": { "useDynamicLimits": false, "feedRateMode": "F-word" }
  },
  "turnaround": { "method": "dwell-rotate", "dwellDegrees": 360, "dwellSpeed": 2000, "payoutTiltAngle": null },
  "physicalLimits": { "maxMandrelDiameter": 150, "maxPartLength": 380, "maxMandrelWeight": null }
}
