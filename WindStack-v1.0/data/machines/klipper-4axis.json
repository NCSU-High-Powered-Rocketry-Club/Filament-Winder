{
  "id": "klipper-4axis-v1",
  "name": "Advanced 4-Axis CNC Winder",
  "description": "Multi-axis Klipper winder: X carriage, Y spindle, Z radial cross-feed, A payout tilt",
  "controller": {
    "type": "klipper",
    "version": "0.12+",
    "connection": { "interface": "file-upload", "host": null }
  },
  "axes": [
    {
      "id": "X", "function": "carriage", "type": "linear", "unit": "mm",
      "range": { "min": 0, "max": 650 },
      "maxSpeed": 12000, "maxAccel": 6000, "homePosition": 0
    },
    {
      "id": "Y", "function": "mandrel_rotation", "type": "rotary", "unit": "degrees",
      "range": { "min": null, "max": null },
      "maxSpeed": 45000, "maxAccel": 15000, "homePosition": 0
    },
    {
      "id": "Z", "function": "cross_feed", "type": "linear", "unit": "mm",
      "range": { "min": 0, "max": 250 },
      "maxSpeed": 5000, "maxAccel": 2500, "homePosition": 0
    },
    {
      "id": "A", "function": "payout_tilt", "type": "rotary", "unit": "degrees",
      "range": { "min": -120, "max": 120 },
      "maxSpeed": 15000, "maxAccel": 8000, "homePosition": 0
    }
  ],
  "gcode": {
    "header": [
      "; Generated by WindStack",
      "; Machine: Advanced 4-Axis CNC Winder",
      "; Controller: Klipper",
      "G90",
      "G92 X0 Y0 Z0 A0"
    ],
    "footer": [
      "M400",
      "G1 X0 A0 F4000",
      "RESPOND MSG=\"WindStack: 4-Axis Winding complete\"",
      "M84"
    ],
    "coordinateMode": "absolute",
    "lineNumbers": false,
    "checksums": false,
    "decimalPlaces": 4,
    "macros": {
      "windStart": "WIND_START",
      "windComplete": "WIND_COMPLETE",
      "turnaroundCW": "TURNAROUND_CW",
      "turnaroundCCW": "TURNAROUND_CCW",
      "layerChange": null,
      "pause": "PAUSE"
    },
    "speedControl": { "useDynamicLimits": true, "feedRateMode": "F-word" }
  },
  "turnaround": { "method": "payout-tilt", "dwellDegrees": 360, "dwellSpeed": 2500, "payoutTiltAngle": 35 },
  "physicalLimits": { "maxMandrelDiameter": 280, "maxPartLength": 600, "maxMandrelWeight": 25 }
}
