{
  "id": "marlin-2axis-v1",
  "name": "Desktop Marlin 2-Axis",
  "description": "Standard 2-axis winder controlled by Marlin firmware (SKR / RAMPS / MKS)",
  "controller": {
    "type": "marlin",
    "version": "2.1+",
    "connection": { "interface": "usb-serial", "baudRate": 115200 }
  },
  "axes": [
    {
      "id": "X", "function": "carriage", "type": "linear", "unit": "mm",
      "range": { "min": 0, "max": 350 },
      "maxSpeed": 8000, "maxAccel": 3000, "homePosition": 0
    },
    {
      "id": "Y", "function": "mandrel_rotation", "type": "rotary", "unit": "degrees",
      "range": { "min": null, "max": null },
      "maxSpeed": 30000, "maxAccel": 8000, "homePosition": 0
    }
  ],
  "gcode": {
    "header": [
      "; Generated by WindStack",
      "; Machine: Desktop Marlin 2-Axis",
      "; Controller: Marlin",
      "G90",
      "M117 WindStack Starting...",
      "G92 X0 Y0"
    ],
    "footer": [
      "M400",
      "G1 X0 F3000",
      "M117 Winding Complete",
      "M84"
    ],
    "coordinateMode": "absolute",
    "lineNumbers": false,
    "checksums": false,
    "decimalPlaces": 4,
    "macros": {
      "windStart": null,
      "windComplete": null,
      "turnaroundCW": null,
      "turnaroundCCW": null,
      "layerChange": null,
      "pause": "M0 Pause Winding"
    },
    "speedControl": { "useDynamicLimits": false, "feedRateMode": "F-word" }
  },
  "turnaround": { "method": "dwell-rotate", "dwellDegrees": 360, "dwellSpeed": 2000, "payoutTiltAngle": null },
  "physicalLimits": { "maxMandrelDiameter": 120, "maxPartLength": 300, "maxMandrelWeight": null }
}
