{
  "id": "linuxcnc-2axis-v1",
  "name": "LinuxCNC / Mach3 2-Axis CNC",
  "description": "Industrial 2-axis filament winder running on LinuxCNC, Mach3, or Mach4 CNC controller",
  "controller": {
    "type": "linuxcnc",
    "version": "2.8+",
    "connection": { "interface": "ethernet", "host": null }
  },
  "axes": [
    {
      "id": "X", "function": "carriage", "type": "linear", "unit": "mm",
      "range": { "min": 0, "max": 500 },
      "maxSpeed": 10000, "maxAccel": 4000, "homePosition": 0
    },
    {
      "id": "A", "function": "mandrel_rotation", "type": "rotary", "unit": "degrees",
      "range": { "min": null, "max": null },
      "maxSpeed": 36000, "maxAccel": 10000, "homePosition": 0
    }
  ],
  "gcode": {
    "header": [
      "; Generated by WindStack for LinuxCNC / Mach3",
      "G21 (Metric)",
      "G90 (Absolute Distance Mode)",
      "G94 (Units Per Minute Feed Mode)",
      "G64 P0.05 (Continuous mode with tolerance)",
      "G92 X0 A0 (Set origin)"
    ],
    "footer": [
      "G1 X0 F3000 (Carriage return)",
      "M30 (End and rewind)"
    ],
    "coordinateMode": "absolute",
    "lineNumbers": false,
    "checksums": false,
    "decimalPlaces": 4,
    "macros": {},
    "speedControl": { "useDynamicLimits": false, "feedRateMode": "F-word" }
  },
  "turnaround": { "method": "dwell-rotate", "dwellDegrees": 360, "dwellSpeed": 2500, "payoutTiltAngle": null },
  "physicalLimits": { "maxMandrelDiameter": 200, "maxPartLength": 480, "maxMandrelWeight": null }
}
