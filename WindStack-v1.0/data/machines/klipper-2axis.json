{
  "id": "klipper-2axis-v1",
  "name": "Workshop 2-Axis Winder",
  "description": "Custom-built desktop filament winder with Raspberry Pi + Klipper",
  "controller": {
    "type": "klipper",
    "version": "0.12+",
    "connection": { "interface": "file-upload", "host": null }
  },
  "axes": [
    {
      "id": "X", "function": "carriage", "type": "linear", "unit": "mm",
      "range": { "min": 0, "max": 300 },
      "maxSpeed": 10000, "maxAccel": 5000, "homePosition": 0
    },
    {
      "id": "Y", "function": "mandrel_rotation", "type": "rotary", "unit": "degrees",
      "range": { "min": null, "max": null },
      "maxSpeed": 36000, "maxAccel": 10000, "homePosition": 0
    }
  ],
  "gcode": {
    "header": ["; Generated by WindStack", "; Machine: Workshop 2-Axis Winder", "; Controller: Klipper", "G90", "G92 X0 Y0"],
    "footer": ["M400", "G1 X0 F3000", "RESPOND MSG=\"WindStack: Winding complete\"", "M84"],
    "coordinateMode": "absolute",
    "lineNumbers": false,
    "checksums": false,
    "decimalPlaces": 4,
    "macros": { "windStart": null, "windComplete": null, "turnaroundCW": null, "turnaroundCCW": null, "layerChange": null, "pause": "PAUSE" },
    "speedControl": { "useDynamicLimits": false, "feedRateMode": "F-word" }
  },
  "turnaround": { "method": "dwell-rotate", "dwellDegrees": 360, "dwellSpeed": 2000, "payoutTiltAngle": null },
  "physicalLimits": { "maxMandrelDiameter": 100, "maxPartLength": 250, "maxMandrelWeight": null }
}
